# FreeToken GLM-5.3-Flash NVFP4 on 1x RTX PRO 6000 (96 GB) + 128 GB DDR5, no swap.
# Sourced by bin/*.sh and the systemd unit. Measured config, 2026-09-02.
CONTAINER=ft-serve
IMAGE=exllamav3-dev:sm120                 # CUDA 13.0 toolchain image (nvcc on PATH) the venv is built in
FT_HOME=/root/workspace/freetoken-prod    # holds src/ (checkout), venv/, home/ (JIT + benchbw cache), logs
FT_REPO=https://github.com/anoane/FreeToken.git
FT_REF=anoane                             # branch: PR #270 head + b12x clamp adapter + resident b12x + MTP wiring (off)
MODEL=/root/workspace/GLM-5.3-Flash-NVFP4 # LibertAIDAI ModelOpt NVFP4 layout (the only one this loader reads)
RES=3-16,23,43-44        # 17 VRAM-resident expert layers -> host pin ~95 GiB; the window is one layer wide
CTX=262144            # KV capacity in tokens (--num-tokens) and --max-seq-len-override
CHUNK=8192            # --max-prefill-length; TTFT 8 s at 23k tokens; with 576 slots peak VRAM 96.6/97.9 GB up to 114k tokens
CACHE_SLOTS=576       # --moe-cache-size (the prefill double-buffer minimum); 620 with CHUNK=4096. Auto-sizing would hand the VRAM to the KV
MAX_OUT=200000
PORT=1919
MEMCAP=118g           # cgroup memory cap: the container is OOM-killed before the host is
MIN_AVAIL_GB=4        # memguard kills the container below this host MemAvailable
EXTRA=
MOE_STATS=1            # TEMPORARY: per-layer decode miss counters (diagnostic)
OFFLOAD_TOPK=6
CACHE_BIAS=0.05
